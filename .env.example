# ==============================================================================
# Environment Configuration - Interview Voice Bridge
# Rename this file to .env and replace placeholders with your actual secrets.
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/interview_voice_bridge?schema=public

# Redis Connection (Optional for caching and pub/sub)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_random_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Device Pairing Configuration
PAIRING_CODE_EXPIRATION_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Deepgram Real-Time Speech-to-Text API Key
# Sign up at https://deepgram.com to obtain your API key.
# Model: Nova-3 streaming (wss://api.deepgram.com/v1/listen)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
